{
  "name": "sfa_mobile_api",
  "version": "0.1.0",
  "description": "Node.js TypeScript mobile API migration for Enhance SFA.",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=16.20.0"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/multipart": "^8.3.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.29.1",
    "mysql2": "^3.11.3",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "toad-cache": "3.7.0"
  }
}
