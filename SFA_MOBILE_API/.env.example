NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sfa_migration
DB_CONNECTION_LIMIT=10

LOG_LEVEL=debug
DEBUG_PAYLOAD=true

FILE_LOG_ENABLED=true
FILE_LOG_PATH=./logs
FILE_LOG_NAME={module}-log-{requestId}-{hh}-{mm}-{ss}-{milliseconds}-{AM/PM}.json
FILE_LOG_RESPONSE_ENABLED=true
FILE_LOG_MAX_RESPONSE_LENGTH=10485760
