		$("#btndeleteall").click(function (e) {
			e.preventDefault();

			var ids = [];
			var grp_no = '';

			// Process only selected row checkboxes
			$('#table-example tbody input[type="checkbox"]:checked').each(function () {

				// Find the Edit link inside the selected checkbox's row
				var editLink = $(this)
					.closest('tr')
					.find('td a[id]')
					.first();

				if (editLink.length === 0) {
					return;
				}

				var str = editLink.attr('id');
				var qry_str = str.split('/');

				if (qry_str.length < 3) {
					return;
				}

				var tbl_id = qry_str[2].split('_');

				if (tbl_id.length < 2) {
					return;
				}

				var primaryKey = tbl_id[0];
				var groupNumber = tbl_id[1];

				if (primaryKey !== '') {
					ids.push(primaryKey);
					grp_no = groupNumber;
				}
			});

			console.log("Selected IDs:", ids);
			console.log("Group Number:", grp_no);

			// No checkbox selected
			if (ids.length === 0) {
				$('#hdndeleteall').val('');

				jAlert(
					'Please select at least one record.',
					'Message'
				);

				return false;
			}

			jConfirm(
				'Are You Sure To Delete This Record(s)?',
				'Message',
				function (resp) {
					if (!resp) {
						return;
					}

					var selectedIds = ids.join(',');

					$('#hdnitemmustno').val(grp_no);
					$('#hdndeleteall').val(selectedIds);

					$.ajax({
						type: "POST",
						url: base_url + "/account/customer/itemmustitemgrid",
						data: {
							hdnitemmustno: grp_no,
							hdndeleteall: selectedIds,
							deleteall: 'yes'
						},
						success: function (returndata) {
							$('#item-grid').html(returndata);
						},
						error: function (xhr) {
							console.log("Delete error:", xhr.responseText);

							jAlert(
								'Unable to delete the selected record.',
								'Message'
							);
						}
					});
				}
			);

			return false;
		});
		
